# Copy this file to `.env` (or `.env.local`) and fill in your own values.
# Never commit the real `.env` — it is already listed in .gitignore.

# OpenAI API key used by the chat route (lib/openai.ts).
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Password required to access the app (verified by the /api/auth route).
ACCESS_PASSWORD=change-me
